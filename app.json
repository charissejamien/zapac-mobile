{
  "expo": {
    "name": "zapac-mobile",
    "slug": "zapac-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bus_icon.png",
    "scheme": "zapacmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.charissejamien.zapac",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "config": {
        "googleMapsApiKey": "AIzaSyCWHublkXuYaWfT68qUwGY3o5L9NB82JA8"
      }
    },
    "android": {
      "package": "com.charissejamien.zapac",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAJP6e_5eBGz1j8b6DEKqLT-vest54Atkc"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/bus_icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zapac to access your photos to set a profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bus_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Zapac to use your location to find nearby stops and routes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
